# Production site URL used for canonical metadata, sitemap, and social previews.
# Set this to your deployed domain, e.g. https://toon-json-converter.com
NEXT_PUBLIC_SITE_URL=https://toon-json-converter.vercel.app

# Optional Firebase project sync
# Copy this file to .env.local and fill these values from Firebase Console > Project settings > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
